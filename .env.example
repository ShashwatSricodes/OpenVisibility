# Copy to .env.local and fill in. .env.local is git-ignored.

# Vercel AI Gateway key: Vercel dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# Optional: Perplexity's own API, used for the Accurate Perplexity preset,
# because the Gateway only offers the cheaper Sonar model.
PERPLEXITY_API_KEY=
# Model or Agent API preset to call on Perplexity's API
PERPLEXITY_DIRECT_MODEL=sonar-pro

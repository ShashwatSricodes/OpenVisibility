# Copy to .env.local and fill in. .env.local is git-ignored.

# Postgres. Leave unset in development to use the embedded database in .data/.
# With Docker: `docker compose up -d`, then uncomment this line.
# DATABASE_URL=postgres://openvisibility:openvisibility@localhost:5432/openvisibility

# Sign-in. Required in production: generate with `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=
# Public URL of the app (used in sign-in links)
BETTER_AUTH_URL=http://localhost:3000
# Production only: other addresses allowed to sign in, comma-separated.
# (In development any local address works: localhost, 127.0.0.1, your network IP.)
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.your-domain.com

# Encrypts the API keys workspaces save in Settings. Required in production;
# generate with `openssl rand -base64 32`. Changing it makes saved keys unreadable.
# ENCRYPTION_KEY=

# Email. Without a Resend key, sign-in links are printed in the terminal.
RESEND_API_KEY=
EMAIL_FROM=OpenVisibility <login@your-domain.com>

# Bright Data: consumer-app answers for ChatGPT, Perplexity and Gemini.
# Free account: 5,000 answers a month, no card.
# Dashboard → Account settings → API key
BRIGHT_DATA_API_KEY=

# Vercel AI Gateway key, for Claude (and API-route comparisons).
# Optional: with it, an AI model writes your prompt suggestions (a fraction of a
# cent each time); without it, suggestions come from built-in templates.
# Vercel dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=
# PROMPT_SUGGEST_MODEL=google/gemini-3.5-flash-lite

# Optional: an analysis model that rates how each answer talks about your brand
# and competitors (sentiment, and whether it recommends them). Any
# OpenAI-compatible API works, including free tiers; without it, you still get
# mentions and positions. Pick one, then restart:
#   Groq (free, no card):     https://api.groq.com/openai/v1       openai/gpt-oss-20b
#   Google Gemini (free):     https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.5-flash-lite
#   OpenRouter (:free models): https://openrouter.ai/api/v1         a model ending in :free
#   Cerebras (free):          https://api.cerebras.ai/v1
#   DeepSeek (cheap):         https://api.deepseek.com/v1         deepseek-chat
#   Ollama (local, no key):   http://localhost:11434/v1           e.g. qwen3:8b
# ANALYSIS_BASE_URL=
# ANALYSIS_API_KEY=
# ANALYSIS_MODEL=
# Answers rated per call (1-20). Lower it if your provider limits tokens per minute.
# ANALYSIS_BATCH=5
# For cost tracking: US dollars per million tokens (leave at 0 on free tiers)
# ANALYSIS_PRICE_INPUT=0
# ANALYSIS_PRICE_OUTPUT=0

# Runs. With the embedded database the run worker runs inside `npm run dev`;
# with DATABASE_URL, start it separately with `npm run worker` (or set inline).
# OV_WORKER=inline
# Answer every prompt instantly with fake answers, to try runs without
# spending Bright Data answers. Development only.
# OV_FAKE_ANSWERS=1
# The site audit refuses domains that point to private or internal addresses.
# Set this to audit a site on your own network (self-hosting only).
# OV_AUDIT_PRIVATE=1

# Optional: Perplexity's own API, for the Accurate Perplexity preset on the API route
PERPLEXITY_API_KEY=
PERPLEXITY_DIRECT_MODEL=sonar-pro


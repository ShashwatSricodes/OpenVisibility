{
  "name": "openvisibility",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "models": "tsx scripts/models.ts",
    "spike": "tsx --env-file-if-exists=.env.local scripts/spike.ts",
    "spike:bd": "tsx --env-file-if-exists=.env.local scripts/spike-brightdata.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local db/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/perplexity": "^5.0.5",
    "@ai-sdk/xai": "^5.0.14",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "^7.0.127",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "15.5.4",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "22.15.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vitest": "^5.0.5"
  }
}
